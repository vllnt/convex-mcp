{
  "name": "@vllnt/convex-mcp",
  "version": "0.2.0",
  "description": "Expose Convex functions as MCP tools with zero boilerplate",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/ tests/",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.check.json",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "convex",
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "tools"
  ],
  "author": {
    "name": "vllnt",
    "url": "https://bntvllnt.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vllnt/convex-mcp"
  },
  "bugs": {
    "url": "https://github.com/vllnt/convex-mcp/issues"
  },
  "homepage": "https://github.com/vllnt/convex-mcp#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "convex": ">=1.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "convex": "^1.36.1",
    "convex-test": "^0.0.50",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
